{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 28,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release"
            }
        },
        {
            "name": "use-modules",
            "hidden": true,
            "cacheVariables": {
                "LCF_ASYNC_USE_MODULES": true
            }
        },
        {
            "name": "msvc",
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "cl"
            },
            "architecture": {
                "value": "x64",
                "strategy": "external"
            }
        },
        {
            "name": "clang",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "name": "gcc",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "g++"
            }
        },
        {
            "name": "msvc-modules",
            "inherits": [
                "msvc",
                "use-modules"
            ]
        },
        {
            "name": "clang-modules",
            "inherits": [
                "clang",
                "use-modules"
            ]
        },
        {
            "name": "gcc-modules",
            "inherits": [
                "gcc",
                "use-modules"
            ]
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "hidden": true,
            "configuration": "Debug"
        },
        {
            "name": "release",
            "hidden": true,
            "configuration": "Release"
        },
        {
            "name": "clang",
            "hidden": true,
            "configurePreset": "clang"
        },
        {
            "name": "clang-modules",
            "hidden": true,
            "configurePreset": "clang-modules"
        },
        {
            "name": "gcc",
            "hidden": true,
            "configurePreset": "gcc"
        },
        {
            "name": "gcc-modules",
            "hidden": true,
            "configurePreset": "gcc-modules"
        },
        {
            "name": "msvc",
            "hidden": true,
            "configurePreset": "msvc"
        },
        {
            "name": "msvc-modules",
            "hidden": true,
            "configurePreset": "msvc-modules"
        },
        {
            "name": "clang-debug",
            "inherits": ["clang", "debug"]
        },
        {
            "name": "clang-release",
            "inherits": ["clang", "release"]
        },
        {
            "name": "clang-modules-debug",
            "inherits": ["clang-modules", "debug"]
        },
        {
            "name": "clang-modules-release",
            "inherits": ["clang-modules", "release"]
        },
        {
            "name": "gcc-debug",
            "inherits": ["gcc", "debug"]
        },
        {
            "name": "gcc-release",
            "inherits": ["gcc", "release"]
        },
        {
            "name": "gcc-modules-debug",
            "inherits": ["gcc-modules", "debug"]
        },
        {
            "name": "gcc-modules-release",
            "inherits": ["gcc-modules", "release"]
        },
        {
            "name": "msvc-debug",
            "inherits": ["msvc", "debug"]
        },
        {
            "name": "msvc-release",
            "inherits": ["msvc", "release"]
        },
        {
            "name": "msvc-modules-debug",
            "inherits": ["msvc-modules", "debug"]
        },
        {
            "name": "msvc-modules-release",
            "inherits": ["msvc-modules", "release"]
        }
    ]
}
