{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 28,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release"
            }
        },
        {
            "name": "use-modules",
            "hidden": true,
            "cacheVariables": {
                "LCF_ASYNC_USE_MODULES": true
            }
        },
        {
            "name": "msvc",
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "cl"
            },
            "architecture": {
                "value": "x64",
                "strategy": "external"
            }
        },
        {
            "name": "clang",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "name": "gcc",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "g++"
            }
        },
        {
            "name": "msvc-modules",
            "inherits": [
                "msvc",
                "use-modules"
            ]
        },
        {
            "name": "clang-modules",
            "inherits": [
                "clang",
                "use-modules"
            ]
        },
        {
            "name": "gcc-modules",
            "inherits": [
                "gcc",
                "use-modules"
            ]
        }
    ]
}
