            "inherits": ["developer", "mode-module", "compiler-clang"],
            "toolset": {
                "value": "version=14.51,host=x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "LCF_ASYNC_ENABLE_ASIO": "OFF",
                "LCF_ASYNC_ENABLE_STDEXEC": "ON",
                "LCF_ASYNC_ENABLE_STANDALONE": "OFF",
                "LCF_ASYNC_BUILD_BACKEND_BENCHMARKS": "OFF",
                "LCF_ASYNC_ASIO_BUILD_TESTS": null,
                "LCF_ASYNC_ASIO_BUILD_VERIFY": null,
                "LCF_ASYNC_ASIO_BUILD_SANDBOX": null,
                "LCF_ASYNC_ASIO_BUILD_BENCHMARKS": null,
                "LCF_ASYNC_ASIO_TESTS_IN_MAIN_BUILD": null,
                "LCF_ASYNC_STANDALONE_BUILD_TESTS": null,
                "LCF_ASYNC_STANDALONE_BUILD_VERIFY": null,
                "LCF_ASYNC_STANDALONE_BUILD_SANDBOX": null,
                "LCF_ASYNC_STANDALONE_BUILD_BENCHMARKS": null,
                "LCF_ASYNC_STANDALONE_TESTS_IN_MAIN_BUILD": null
            }
        },
        {
            "name": "module-standalone-msvc",
            "displayName": "async / standalone module / MSVC 14.51",
            "description": "Develop the standalone backend with explicit import lcf.async, verify, sandbox and benchmarks.",
            "inherits": [
                "developer",
                "mode-module",
                "compiler-msvc"
            ],
            "cacheVariables": {
                "LCF_ASYNC_ENABLE_ASIO": "OFF",
                "LCF_ASYNC_ENABLE_STDEXEC": "OFF",
                "LCF_ASYNC_ENABLE_STANDALONE": "ON",
                "LCF_ASYNC_BUILD_BACKEND_BENCHMARKS": "OFF",
                "LCF_ASYNC_ASIO_BUILD_TESTS": null,
                "LCF_ASYNC_ASIO_BUILD_VERIFY": null,
                "LCF_ASYNC_ASIO_BUILD_SANDBOX": null,
                "LCF_ASYNC_ASIO_BUILD_BENCHMARKS": null,
                "LCF_ASYNC_ASIO_TESTS_IN_MAIN_BUILD": null,
                "LCF_ASYNC_STDEXEC_BUILD_TESTS": null,
                "LCF_ASYNC_STDEXEC_BUILD_VERIFY": null,
                "LCF_ASYNC_STDEXEC_BUILD_SANDBOX": null,
                "LCF_ASYNC_STDEXEC_BUILD_BENCHMARKS": null,
                "LCF_ASYNC_STDEXEC_TESTS_IN_MAIN_BUILD": null
            }
        }
