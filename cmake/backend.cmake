include_guard(GLOBAL)
include(CMakeDependentOption)
include(GNUInstallDirs)

macro(async_backend_options backend benchmark_default)
    string(TOUPPER "${backend}" async_backend_key)
    set(async_options_prefix "LCF_ASYNC_${async_backend_key}")
    cmake_dependent_option(${async_options_prefix}_BUILD_TESTS "Provide ${backend} development targets" ON
        "LCF_ASYNC_BUILD_TESTS" OFF)
    foreach(async_kind VERIFY SANDBOX BENCHMARKS)
        set(async_option_default ON)
        if(async_kind STREQUAL "BENCHMARKS")
            set(async_option_default ${benchmark_default})
        endif()
        cmake_dependent_option(${async_options_prefix}_BUILD_${async_kind} "Provide ${backend} ${async_kind}" ${async_option_default}
            "${async_options_prefix}_BUILD_TESTS" OFF)
    endforeach()
    cmake_dependent_option(${async_options_prefix}_TESTS_IN_MAIN_BUILD "Configure development executables in this build" OFF
        "${async_options_prefix}_BUILD_TESTS" OFF)
    foreach(async_provider ${ARGN})
        set(${async_provider} "" CACHE STRING "Override dependency provider; empty inherits library policy")
        set_property(CACHE ${async_provider} PROPERTY STRINGS "" PACKAGE PROVIDED FETCH)
        mark_as_advanced(${async_provider})
    endforeach()
endmacro()

function(async_add_backend backend)
    cmake_parse_arguments(PARSE_ARGV 1 ARG "" "" "LIBRARIES;SOURCES")
    if(ARG_UNPARSED_ARGUMENTS OR ARG_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "Invalid async_add_backend arguments: ${ARG_UNPARSED_ARGUMENTS};${ARG_KEYWORDS_MISSING_VALUES}")
    endif()
    set(target async_${backend})
    if(LCF_ASYNC_USE_MODULES)
        if(NOT CMAKE_GENERATOR MATCHES "Ninja|Visual Studio")
            message(FATAL_ERROR "lcf.async modules require Ninja or Visual Studio with module scanning")
        endif()
        if(NOT CMAKE_CXX_SCANDEP_SOURCE)
            message(FATAL_ERROR "This compiler/CMake combination cannot scan C++ named modules")
        endif()
        add_library(${target} STATIC)
        target_sources(${target} PUBLIC FILE_SET CXX_MODULES BASE_DIRS modules FILES modules/async.cppm)
        set(scope PUBLIC)
    else()
        add_library(${target} INTERFACE)
        set(scope INTERFACE)
    endif()
    add_library(lcf::${target} ALIAS ${target})
    target_compile_features(${target} ${scope} cxx_std_23)
    target_include_directories(${target} ${scope}
        "$<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include>"
        "$<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}/lcf_async/${backend}>")
    target_link_libraries(${target} ${scope} ${ARG_LIBRARIES})
    set_target_properties(${target} PROPERTIES CXX_EXTENSIONS OFF
        CXX_SCAN_FOR_MODULES "${LCF_ASYNC_USE_MODULES}" FOLDER "async/${backend}")
    if(MSVC)
        target_compile_options(${target} ${scope} /Zc:__cplusplus /Zc:preprocessor /permissive- /bigobj)
    endif()
    include("${CMAKE_CURRENT_SOURCE_DIR}/cmake/sources.cmake")
    target_sources(${target} PRIVATE ${async_header_sources} ${ARG_SOURCES})
    set(implementation_sources ${async_header_sources} ${ARG_SOURCES})
    if(LCF_ASYNC_USE_MODULES)
        list(APPEND implementation_sources modules/async.cppm)
    endif()
    list(TRANSFORM implementation_sources PREPEND "${CMAKE_CURRENT_SOURCE_DIR}/")
    source_group(TREE "${CMAKE_CURRENT_SOURCE_DIR}" FILES ${implementation_sources})
    set(async_implementation_sources "${implementation_sources}" PARENT_SCOPE)
endfunction()

macro(async_backend_development backend)
    string(TOUPPER "${backend}" async_backend_key)
    if(LCF_ASYNC_${async_backend_key}_BUILD_TESTS)
        enable_testing()
        add_subdirectory(tests)
    endif()
    if(LCF_ASYNC_INSTALL)
        include(cmake/install.cmake)
        if(CMAKE_SOURCE_DIR STREQUAL CMAKE_CURRENT_SOURCE_DIR)
            include("${CMAKE_CURRENT_LIST_DIR}/../cmake/install.cmake")
        endif()
    endif()
endmacro()
