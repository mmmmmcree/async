include_guard(GLOBAL)

# condition is optional: true means the dependency is needed, false skips it.
# A string is a CMake if-expression. A {"cmake": "path"} script sets dependency_required.
function(lcf_dependency_required entry manifest_dir output)
    string(JSON condition_type ERROR_VARIABLE missing TYPE "${entry}" condition)
    if(missing)
        set(${output} ON PARENT_SCOPE)
        return()
    endif()

    if(condition_type STREQUAL "STRING")
        string(JSON condition GET "${entry}" condition)
        set(dependency_required OFF)
        cmake_language(EVAL CODE
            "if(${condition})\nset(dependency_required ON)\nendif()")
    elseif(condition_type STREQUAL "OBJECT")
        string(JSON script GET "${entry}" condition cmake)
        get_filename_component(script "${script}" ABSOLUTE BASE_DIR "${manifest_dir}")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${script}")
        unset(dependency_required)
        include("${script}")
        if(NOT DEFINED dependency_required)
            message(FATAL_ERROR "Dependency check ${script} must set dependency_required")
        endif()
    else()
        message(FATAL_ERROR "Dependency condition must be a string or a cmake script object")
    endif()
    set(${output} "${dependency_required}" PARENT_SCOPE)
endfunction()

# Optional JSON string arrays keep dependency usage requirements in the manifest.
function(lcf_dependency_list entry field output)
    set(items)
    string(JSON count ERROR_VARIABLE missing LENGTH "${entry}" ${field})
    if(NOT missing AND count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(index RANGE 0 ${last})
            string(JSON item GET "${entry}" ${field} ${index})
            list(APPEND items "${item}")
        endforeach()
    endif()
    set(${output} "${items}" PARENT_SCOPE)
endfunction()
