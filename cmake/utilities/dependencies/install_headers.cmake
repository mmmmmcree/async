cmake_minimum_required(VERSION 3.28)

# Staging metadata is generated by the shared dependency resolver, not a manifest file.
include("${DEPENDENCY_FILE}")
foreach(directory IN LISTS dependency_INCLUDE_DIRECTORIES)
    if(NOT IS_DIRECTORY "${SOURCE_DIR}/${directory}")
        message(FATAL_ERROR "Missing dependency headers: ${SOURCE_DIR}/${directory}")
    endif()
    file(COPY "${SOURCE_DIR}/${directory}/" DESTINATION "${INSTALL_DIR}/include")
endforeach()

set(find_dependencies "")
foreach(package IN LISTS dependency_FIND_PACKAGES)
    string(APPEND find_dependencies "find_dependency(${package})\n")
endforeach()
set(usage_requirements "")
foreach(field LINK_LIBRARIES COMPILE_FEATURES COMPILE_DEFINITIONS COMPILE_OPTIONS)
    if(dependency_${field})
        string(APPEND usage_requirements
            "    set_property(TARGET ${dependency_TARGET} PROPERTY INTERFACE_${field} [==[${dependency_${field}}]==])\n")
    endif()
endforeach()
set(config [=[
include(CMakeFindDependencyMacro)
@find_dependencies@
if(NOT TARGET @dependency_TARGET@)
    get_filename_component(_dependency_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
    add_library(@dependency_TARGET@ INTERFACE IMPORTED)
    set_target_properties(@dependency_TARGET@ PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${_dependency_prefix}/include")
@usage_requirements@
    unset(_dependency_prefix)
endif()
]=])
string(CONFIGURE "${config}" config @ONLY)
file(MAKE_DIRECTORY "${INSTALL_DIR}/lib/cmake/${dependency_PACKAGE}")
file(WRITE "${INSTALL_DIR}/lib/cmake/${dependency_PACKAGE}/${dependency_PACKAGE}Config.cmake" "${config}")
