# Initialize dependency state; manifests declare regular project dependencies.
include("${CMAKE_CURRENT_LIST_DIR}/condition.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/dependency.cmake")
set(lib_dependency_prefix "${CMAKE_CURRENT_BINARY_DIR}/_deps/install")
set(lib_dependency_targets)
set(lib_external_dependency_targets)
set(lib_dependency_packages)
set(lib_package_dependencies "")
set(lib_required_dependencies)
add_custom_target(${lib_target}_install_dependencies)

set(lib_manifest "${lib_root}/deps.json")
if(NOT EXISTS "${lib_manifest}")
    return()
endif()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${lib_manifest}")
file(READ "${lib_manifest}" lib_dependencies)
string(JSON dependency_count LENGTH "${lib_dependencies}" dependencies)
if(dependency_count EQUAL 0)
    return()
endif()
math(EXPR last_dependency "${dependency_count} - 1")
foreach(index RANGE 0 ${last_dependency})
    string(JSON entry GET "${lib_dependencies}" dependencies ${index})
    string(JSON name GET "${entry}" name)
    lcf_dependency_required("${entry}" "${lib_root}" required)
    if(NOT required)
        message(STATUS "${lib_name}: skipping dependency ${name} (condition is false)")
        continue()
    endif()
    set(arguments NAME "${name}")
    foreach(field target package scope git git_tag)
        string(JSON value ERROR_VARIABLE missing GET "${entry}" ${field})
        if(NOT missing)
            string(TOUPPER "${field}" key)
            list(APPEND arguments ${key} "${value}")
        endif()
    endforeach()
    foreach(field include_directories find_packages link_libraries
            compile_features compile_definitions compile_options)
        lcf_dependency_list("${entry}" ${field} values)
        if(values)
            string(TOUPPER "${field}" key)
            list(APPEND arguments ${key} ${values})
        endif()
    endforeach()
    lcf_dependency(${arguments})
endforeach()
