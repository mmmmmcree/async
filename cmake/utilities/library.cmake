set(lib_root "${CMAKE_CURRENT_SOURCE_DIR}")
set(lib_target ${lib_name})
set(lib_package_dependencies "")
set(lib_dependency_packages)
set(lib_external_dependency_targets)
set(lib_dependency_prefix "")
if(NOT lib_namespace)
    set(lib_namespace ${lib_package})
endif()
if(NOT lib_option_prefix)
    string(TOUPPER "${lib_name}" lib_key)
    set(lib_option_prefix LCF_${lib_key})
endif()
if(NOT DEFINED CMAKE_CXX_STANDARD)
    set(CMAKE_CXX_STANDARD ${lib_cxx_standard})
endif()
set(CMAKE_CXX_STANDARD_REQUIRED ON)
include("${CMAKE_CURRENT_LIST_DIR}/options.cmake")
set(CMAKE_CXX_SCAN_FOR_MODULES ${${lib_option_prefix}_USE_MODULES})

if(lib_header_only AND NOT ${lib_option_prefix}_USE_MODULES)
    add_library(${lib_target} INTERFACE)
    set(lib_scope INTERFACE)
elseif(lib_header_only)
    add_library(${lib_target} STATIC)
    set(lib_scope PUBLIC)
else()
    # BUILD_SHARED_LIBS belongs to the caller; do not fix STATIC/SHARED in the template.
    add_library(${lib_target} ${lib_sources})
    set(lib_scope PUBLIC)
endif()
get_target_property(lib_build_type ${lib_target} TYPE)
string(REPLACE "_LIBRARY" "" lib_build_type "${lib_build_type}")
add_library(${lib_namespace}::${lib_target} ALIAS ${lib_target})
target_compile_features(${lib_target} ${lib_scope} cxx_std_${lib_cxx_standard})
target_compile_options(${lib_target} ${lib_scope}
    "$<$<COMPILE_LANG_AND_ID:CXX,MSVC>:/Zc:__cplusplus;/Zc:preprocessor>")
target_sources(${lib_target} ${lib_scope}
    FILE_SET HEADERS BASE_DIRS include FILES ${lib_headers})

if(NOT lib_build_type STREQUAL "INTERFACE")
    set_target_properties(${lib_target} PROPERTIES CXX_EXTENSIONS OFF)
    if(NOT DEFINED CMAKE_POSITION_INDEPENDENT_CODE)
        set_target_properties(${lib_target} PROPERTIES POSITION_INDEPENDENT_CODE ON)
    endif()
endif()
if(NOT lib_header_only)
    include(GenerateExportHeader)
    set(export_header "${CMAKE_CURRENT_BINARY_DIR}/include/${lib_name}/export.h")
    generate_export_header(${lib_target}
        EXPORT_FILE_NAME "${export_header}"
        EXPORT_MACRO_NAME ${lib_option_prefix}_API
        STATIC_DEFINE ${lib_option_prefix}_STATIC_DEFINE)
    target_sources(${lib_target} PUBLIC FILE_SET HEADERS
        BASE_DIRS "${CMAKE_CURRENT_BINARY_DIR}/include" FILES "${export_header}")
    if(lib_build_type STREQUAL "STATIC")
        target_compile_definitions(${lib_target} PUBLIC ${lib_option_prefix}_STATIC_DEFINE)
    endif()
    target_include_directories(${lib_target} PRIVATE "${lib_root}/src")
endif()
if(${lib_option_prefix}_USE_MODULES)
    if(NOT lib_module_files OR NOT CMAKE_CXX_SCANDEP_SOURCE)
        message(FATAL_ERROR "${lib_name}: modules require compiler/generator scanning support")
    endif()
    target_sources(${lib_target} PUBLIC
        FILE_SET CXX_MODULES TYPE CXX_MODULES BASE_DIRS modules FILES ${lib_module_files})
    target_compile_features(${lib_target} PUBLIC cxx_std_${CMAKE_CXX_STANDARD})
endif()
include("${CMAKE_CURRENT_LIST_DIR}/dependencies/resolve.cmake")
